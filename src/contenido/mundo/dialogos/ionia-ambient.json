  {
    "id": "jo05_placidium-ambient-9",
    "nodoInicialId": "inicio",
    "nodos": [
      {
        "id": "inicio",
        "interlocutor": "Espíritu de pétalo",
        "modo": "habla",
        "lineas": [
          "Escuchas un tintineo, suave como lluvia sobre hojas.",
          "El espíritu gira a tu alrededor y deja un pétalo suspendido antes de alejarse."
        ],
        "acciones": []
      }
    ]
  }
]
