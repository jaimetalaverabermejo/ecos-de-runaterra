    "actualizarMundoAlCerrar": true,
    "nodos": [
      {
        "id": "0",
        "interlocutor": "Iria",
        "lineas": [
          "Era aprendiz. Me dijeron que necesitaban a alguien capaz de distinguir una reacción del cristal. En el carro se quedaron con mi nombre. Iria. Si vas a escribir algo, escribe eso."
        ],
        "acciones": [
          {
            "tipo": "evento-mision",
            "evento": "interact",
