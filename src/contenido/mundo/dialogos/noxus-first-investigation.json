  {
    "id": "noxus-supplies-dalen",
    "nodoInicialId": "0",
    "actualizarMundoAlCerrar": true,
    "nodos": [
      {
        "id": "0",
        "interlocutor": "Dalen",
        "lineas": [
          "A mí me preguntaron qué sentía cuando me acercaban la placa. Cuando contesté me cambiaron de carro. Encontré esto bajo la manta."
        ],
        "siguienteNodoId": "1"
      },
      {
        "id": "1",
        "interlocutor": "Viajero",
        "lineas": [
          "Dice «Compatible. Traslado central». No figura ninguno de vosotros en el parte de Basilich."
        ],
        "siguienteNodoId": "2"
      },
      {
        "id": "2",
        "interlocutor": "Dalen",
        "lineas": [
          "Tampoco figurábamos en el siguiente puesto. Díselo a quien lea ese papel."
        ],
        "siguienteNodoId": "3"
      },
      {
        "id": "3",
        "interlocutor": "Rell",
        "lineas": [
          "Lleva las tres pruebas al Bastión. Cuando Mel pregunte a quién sacamos, di sus nombres antes de hablar de la ficha. Iria y Dalen."
        ],
        "campeonId": "rell",
        "acciones": [
          {
            "tipo": "evento-mision",
            "evento": "interact",
            "objetivoId": "supplies-record-transfer"
          },
          {
            "tipo": "completar-mision",
            "misionId": "noxus-not-supplies"
          },
          {
            "tipo": "bandera",
            "id": "story:noxus-relocation-found",
            "valor": true
          }
        ]
      }
