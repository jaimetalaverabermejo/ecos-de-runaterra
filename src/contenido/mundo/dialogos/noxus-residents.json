  {
    "id": "no03-casa-01-residente-dialogo",
    "nodoInicialId": "inicio",
    "nodos": [
      {
        "id": "inicio",
        "interlocutor": "Vecina",
        "modo": "habla",
        "lineas": [
          "Siéntate cerca del fuego. Junto a la puerta siempre se cuela aire."
        ],
        "acciones": []
      }
    ]
  },
  {
    "id": "no03-casa-02-residente-dialogo",
    "nodoInicialId": "inicio",
    "nodos": [
      {
        "id": "inicio",
        "interlocutor": "Cuidadora",
        "modo": "habla",
        "lineas": [
          "Dejo las botas cerca de la leña. Traer barro hasta el comedor da el doble de trabajo."
        ],
        "acciones": []
      }
    ]
  },
  {
    "id": "no03-casa-03-residente-dialogo",
    "nodoInicialId": "inicio",
