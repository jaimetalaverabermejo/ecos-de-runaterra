  {
    "id": "no03-casa-04-residente-dialogo",
    "nodoInicialId": "inicio",
    "nodos": [
      {
        "id": "inicio",
        "interlocutor": "Residente",
        "modo": "habla",
        "lineas": [
          "La mesa se pone al anochecer. Hasta entonces, deja el centro libre."
        ],
        "acciones": []
      }
    ]
  },
  {
    "id": "no03-casa-05-residente-dialogo",
    "nodoInicialId": "inicio",
    "nodos": [
      {
        "id": "inicio",
        "interlocutor": "Artesana",
        "modo": "habla",
        "lineas": [
          "Trabajo sobre la piedra. Al otro lado guardo lo que debe quedar lejos del polvo."
        ],
        "acciones": []
      }
    ]
  },
  {
    "id": "no03-casa-06-residente-dialogo",
    "nodoInicialId": "inicio",
    "nodos": [
      {
        "id": "inicio",
        "interlocutor": "Residente",
        "modo": "habla",
        "lineas": [
          "Cada cual tiene su cuarto al fondo. Compartimos la chimenea y todo lo que se cuece en ella."
        ],
        "acciones": []
      }
    ]
  },
  {
