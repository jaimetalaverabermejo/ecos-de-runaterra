      {
        "id": "inicio",
        "interlocutor": "Irelia",
        "lineas": [
          "Los hemos obligado a replegarse, pero el corredor sigue cerrado. Mira cuántos escudos hay detrás de la segunda fila."
        ],
        "acciones": [],
        "siguienteNodoId": "1"
      },
      {
        "id": "1",
        "interlocutor": "Viajero",
        "lineas": [
          "Los heridos necesitan bajar por aquí."
        ],
        "acciones": [],
        "siguienteNodoId": "2"
      },
      {
        "id": "2",
        "interlocutor": "Irelia",
        "lineas": [
          "Entonces despejaremos esta posición. Tú ve a por los dos que guardan la salida; yo impediré que los refuerzos lleguen hasta ellos."
        ],
        "acciones": [
          {
            "tipo": "cinematica",
            "escenaId": "jonia-flank-2"
          }
        ]
      }
